# Core runtime
WEAVIATE_URL=http://localhost:8080
OPA_URL=http://localhost:8181
TOP_K=5
RETRIEVAL_MODE=auto

# Backward-compatible LiteLLM defaults (used when CHAT_* are unset)
LITELLM_BASE_URL=http://localhost:4000
DEFAULT_MODEL=gpt-4o-mini
LITELLM_MODEL=gpt-4o-mini
LITELLM_API_KEY=
STRUCTURED_OUTPUT_MODE=auto

# Optional chat provider split (Groq chat example)
CHAT_BASE_URL=https://api.groq.com/openai/v1
CHAT_API_KEY=your_groq_api_key_here
CHAT_MODEL=llama-3.1-8b-instant

# Optional embeddings provider split (OpenRouter embeddings example)
EMBEDDING_BASE_URL=https://openrouter.ai/api/v1
EMBEDDING_API_KEY=your_openrouter_api_key_here
EMBEDDING_MODEL=text-embedding-3-small

# Tracing / app behavior
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000
RAGSHIELD_ENV=dev
DEBUG_TRACE=false
