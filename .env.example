# Core runtime
WEAVIATE_URL=http://localhost:8080
OPA_URL=http://localhost:8181
TOP_K=5
RETRIEVAL_MODE=auto

# LiteLLM proxy defaults
LITELLM_BASE_URL=http://localhost:4000
DEFAULT_MODEL=gpt-4o-mini
LITELLM_MODEL=gpt-4o-mini
LITELLM_API_KEY=
STRUCTURED_OUTPUT_MODE=auto

# Chat via LiteLLM proxy (Groq upstream)
CHAT_BASE_URL=http://localhost:4000
CHAT_API_KEY=
CHAT_MODEL=groq-llama-3.1-8b-instant
GROQ_API_KEY=your_groq_api_key_here

# Embeddings directly via OpenRouter (independent from chat proxy)
EMBEDDING_BASE_URL=https://openrouter.ai/api/v1
EMBEDDING_API_KEY=your_openrouter_api_key_here
EMBEDDING_MODEL=provider/model  # Run scripts/check_openrouter_embeddings_models.py to choose a valid id

# Tracing / app behavior
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000
RAGSHIELD_ENV=dev
DEBUG_TRACE=false
